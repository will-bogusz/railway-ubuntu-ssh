# Installed as /etc/ssh/sshd_config.d/10-railway.conf; first match wins, so
# these override the Ubuntu defaults in /etc/ssh/sshd_config.
Port 22
ListenAddress 0.0.0.0
HostKey /home/dev/.devbox/ssh_host_ed25519_key
HostKey /home/dev/.devbox/ssh_host_rsa_key
HostKey /home/dev/.devbox/ssh_host_ecdsa_key

AllowUsers dev
PermitRootLogin no
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/authorized_keys.d/%u
MaxAuthTries 4
LoginGraceTime 30
# Unauthenticated connections per source IP are capped (OpenSSH >= 8.5): the
# brute-force limiter that needs no capabilities. fail2ban stacks on top when
# iptables is usable.
MaxStartups 10:30:60
PerSourceMaxStartups 3
PerSourceNetBlockSize 32:128
UsePAM yes

ClientAliveInterval 60
ClientAliveCountMax 3
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_* COLORTERM
Subsystem sftp /usr/lib/openssh/sftp-server
